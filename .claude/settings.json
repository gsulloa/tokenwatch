{
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(cargo:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(curl -s:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin dev:*)",
      "Bash(git push origin master:*)",
      "Bash(gh release:*)",
      "Bash(pnpm --filter tokenwatch release:*)",
      "Bash(bash packages/app/scripts/release.sh:*)",
      "Bash(pnpm --filter infra cdk deploy:*)",
      "Bash(pnpm infra cdk deploy:*)",
      "Bash(security find-generic-password:*)"
    ]
  }
}
